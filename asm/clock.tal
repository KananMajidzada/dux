; clock.tal - a digital clock. The time, and the time.
;
;   ./duxasm -X -o roms/clock.rom asm/clock.tal
;   ./dux -f 2 -p /tmp/clock.ppm roms/clock.rom
;   ./duxsdl roms/clock.rom
;
; One line, HH:MM:SS, in the eight by eight monospaced bitmap font in
; asm/lib/fontlib.tal. The time comes off the Datetime device, which is
; read-only and is sampled once a frame, so the display cannot lag the host
; clock by anything and there is nothing here to fall out of step with it.
;
; Three things this is built around, all of them machine details rather than
; taste, and all three of them a mistake I made first:
;
; Monospaced, and the cursor does the placing
; ------------------------------------------
; One cell is an eight pixel glyph and an EIGHT pixel gap, so every cell is
; sixteen wide and a digit occupies the same sixteen pixels whether or not it
; is lit. That is the whole of it, and it is what stops a clock twitching: a
; strip that advances by the width of each glyph has a 1 that is eight pixels
; narrower than an 8, so the minutes jump sideways every time the tens digit
; changes and the row stops being a row.
;
; @char leaves the cursor on the NEXT cell, so @draw never adds a pitch to a
; column and there is no column constant to be wrong. @putat draws one glyph
; where the cursor is and @pairat draws two, and each leaves it further on; the
; order of the calls in @draw IS the order on screen. The digits land at 100,
; 116, then the colon at 132, then 148, 164, the colon at 180, then 196 and
; 212, which is eight cells centred on the 160 of a 320 wide screen.
;
; Drawn with @plot, not the sprite port
; ------------------------------------
; A sprite byte is four pixels at TWO BITS each, and two bits is a colour
; rather than a pixel, so a one-bit glyph has to be repacked before it can be
; stamped and the repack is a second description of the same shape that can
; disagree with the first. @glyph takes the font bytes as they are, one @plot a
; lit pixel. It costs five device writes a pixel against four a row, and it
; cannot be a pixel wrong.
;
; Redraw everything, every frame
; -----------------------------
; @clear first, then the lot. It is wasteful and it is still right, because
; nothing here remembers what was on the screen last frame, so there is no state
; to be stale and a digit cannot be left behind under the one that replaced it.
; A version that cleared only the old digits' boxes left the bottom bar of an 8
; behind when it became a 1, and the time then read as a 1 sitting on a stripe
; - invisible to a pixel count, obvious to anyone looking at it.
;
; What it cannot do is make the digits change at the same instant the host does.
; The three fields are three reads, and a second boundary landing between them
; shows an hour and minute from before it and a second from after it. Reading
; all three into memory before drawing any of them shrinks that window to three
; loads, which is smaller but not zero, and not worth three more zero page
; shorts to claim otherwise.

INCLUDE "common.tal"
INCLUDE "lib/fontlib.tal"
INCLUDE "lib/ascii.tal"

@CLK.hour    = $c6       ; 0-23
@CLK.minute  = $c7       ; 0-59
@CLK.second  = $c8       ; 0-59

; --------------------------------------------------------------- zero page
;
; $28 to $37. common.tal owns $10 to $26 and $7e and $7f; fontlib owns $a0 to
; $ab. Shorts sit on even addresses, because a short keeps its high byte at the
; lower one, and every name here is used at one width and one width only - the
; assembler's zero page lint is what keeps that true, because a short stored a
; byte at a time is a counter that jumps to 256 on its first step.
;
; @ZP.gx and @ZP.gy are the cursor that every drawing routine reads and advances,
; and the reason there is no x or y argument anywhere below @draw.

@ZP.gx  = $28            ; the cursor: the next cell's column, a short
@ZP.gy  = $2a            ; and its row, a short
@ZP.gp  = $2c            ; the glyph being walked to, a short
@ZP.v   = $2e            ; the value being split into digits, a short
@ZP.ten = $30            ; ... and its two halves
@ZP.un  = $32
@ZP.ci  = $34            ; @char's countdown, a short
@ZP.gc  = $36            ; the colour being drawn in, a byte

; ------------------------------------------------------------------ layout
;
; @CELL is the only distance in this file. Eight cells at sixteen is 128 wide
; and the last cell's eight pixel gap is not visible, so the visible run is
; 120 and half of 320 minus that is 100.
@CELL     = $0010        ; sixteen: an eight pixel glyph and an eight pixel gap
@ROW      = $0060        ; 96, the top of the glyphs; 8 rows down puts the
                          ; strip's middle on the middle row of a 200 tall screen
@COL.8    = $0064        ; 100, for the eight cells of HH:MM:SS

; Colours out of the four common.tal sets: 0 background, 1 white, 2 pink,
; 3 grey. The digits are white because they are the thing being read, and the
; colons are grey because they are punctuation and the eye should skip them.

; ------------------------------------------------------------------- glyphs
;
; The table is indexed by character: the glyph for code c is at
; @font + (c - $20) * 8, which @char below does by subtracting and then walking.
; So a caller writes the character's own code and there is no font-specific
; constant anywhere - the colon is $3a because a colon is $3a, not because this
; font happens to keep it at index 36.
@CH.DIGIT  = $30             ; so the digits are $30 to $39, and ten of them
@CH.COLON  = $3a

; -------------------------------------------------------------------- draw
;
; Called once at reset and again every frame by common.tal's vector.
@draw
        JSR2 @clear

        LIT2 @ROW
        STA2 $ZP.gy
        LIT2 @COL.8
        STA2 $ZP.gx

        ; DEI pushes a BYTE and @pairat wants a short, so the value goes through
        ; @widen. Not optional and not a convenience: DEI2 would read the byte
        ; and the byte ABOVE it, and the byte above hour $c6 is the low half of
        ; year $c3, which is the low byte of the year. A short read of a byte
        ; port reads the neighbouring field, and on a page whose whole layout is
        ; that ports come in pairs that is off by one in a way that looks like
        ; a clock running fast rather than like a bug.
        DEI @CLK.hour
        JSR2 @widen
        LIT $01                      ; white
        JSR2 @pairat

        ; The cursor is now on the colon's cell: @pairat left it two cells
        ; along from where it started, and the colon is the next cell of the
        ; strip. @putat draws one glyph where the cursor is and steps on, so
        ; nothing has to say where the colon goes.
        LIT2 @CH.COLON
        LIT $03                      ; grey
        JSR2 @putat

        DEI @CLK.minute
        JSR2 @widen
        LIT $01
        JSR2 @pairat

        LIT2 @CH.COLON
        LIT $03
        JSR2 @putat

        DEI @CLK.second
        JSR2 @widen
        LIT $01
        JSR2 @pairat

        JMP2r2

; ------------------------------------------------------------------- putat
;
; Stack: index short, colour byte. Three in, none out.
;
; One glyph at the cursor. A tail call to @char, so the cursor is stepped in
; exactly one place: @char is the only routine that moves it, which is what
; makes the strip monospaced rather than merely spaced out.
@putat
        STA $ZP.gc
        STA2 $ZP.v                   ; the index, held while gx and gy go on
        LDA2 $ZP.gx
        LDA2 $ZP.gy
        LDA2 $ZP.v
        LDZ $ZP.gc
        JMP2 @char

; ------------------------------------------------------------------ pairat
;
; Stack: value short, colour byte. Three in, none out.
;
; Two digits at the cursor, the value assumed to be under a hundred. A tail call
; to @pair, for the same reason @putat is one.
@pairat
        STA $ZP.gc
        STA2 $ZP.v
        LDA2 $ZP.gx
        LDA2 $ZP.gy
        LDA2 $ZP.v
        LDZ $ZP.gc
        JMP2 @pair

; -------------------------------------------------------------------- pair
;
; Stack: x short, y short, value short, colour byte. Seven in, none out.
;
; Two digits, tens then units, one cell apart. The units digit is drawn at
; whatever @char left the cursor at rather than at the tens column plus a
; pitch: the second digit's column is a consequence of the first one having
; been drawn, not a constant that has to be kept in step with it.
@pair
        STA $ZP.gc
        STA2 $ZP.v
        STA2 $ZP.gy
        STA2 $ZP.gx

        ; tens = value / 10, then units = value - tens*10.
        ;
        ; Both in short arithmetic even though the value is under a hundred and
        ; a byte divide would do. @char takes its index as a SHORT so that
        ; nothing in the digit path has to narrow one, and narrowing is the
        ; mistake this machine makes most easily: a short is two bytes and a
        ; byte store takes one of them and leaves the other underneath, so the
        ; value is right and the stack is a byte deeper than it was, which shows
        ; up as a font that melts towards the right.
        LDA2 $ZP.v
        LIT2 $000a
        DIV2
        STA2 $ZP.ten

        LDA2 $ZP.v
        LDA2 $ZP.ten
        LIT2 $000a
        MUL2
        SUB2
        STA2 $ZP.un

        LDA2 $ZP.gx
        LDA2 $ZP.gy
        LDA2 $ZP.ten
        LIT2 @CH.DIGIT               ; '0' plus the tens, so a character code
        ADD2
        LDZ $ZP.gc
        JSR2 @char

        LDA2 $ZP.gx                   ; wherever the tens digit left the cursor
        LDA2 $ZP.gy
        LDA2 $ZP.un
        LIT2 @CH.DIGIT
        ADD2
        LDZ $ZP.gc
        JSR2 @char

        JMP2r2

; -------------------------------------------------------------------- char
;
; Stack: x short, y short, character short, colour byte. Seven in, none out.
;
; The glyph for that character code, at that x and y, and then the cursor one
; cell further on.
;
; The code becomes a glyph by subtracting the space and walking from @font,
; which is the whole of the addressing: the table is in character order from
; $20 up, so the offset is (code - $20) and there is no map to consult. The
; $20 goes on FIRST because the operand pushed first is the one a subtraction
; takes away. The other way round computes $20 - code, which is a large positive
; number rather than a negative one, so the walk runs off the end of the table
; and into the program's own code, drawing instructions as glyphs.
;
; The walk is kept rather than replaced with a multiply by eight. It costs up to
; $5e steps for the last character in the table against one MUL2, and a clock
; that draws eight glyphs a frame cannot tell the difference. It is also the
; reason to keep this table in character order, and the reason not to adopt a
; 512 glyph font wholesale: that would be up to 511 steps a glyph, which is fine
; for a clock and hopeless for a screenful of text.
@char
        STA $ZP.gc
        STA2 $ZP.ci
        STA2 $ZP.gy
        STA2 $ZP.gx
        LDA2 $ZP.ci
        LIT2 $0020
        SUB2                    ; the character's glyph: its code less the space
        STA2 $ZP.ci
        LIT2 @font
        STA2 $ZP.gp

; The walk and the draw are separate on purpose, exactly as in @num. Drawing on
; every step stacks glyph zero through glyph n on the same spot, and since
; @glyph only ever lights pixels and never clears them, the last one drawn is
; not what you see - the union of all of them is. That reads as a plausible
; smear rather than as a failure, which is the worst kind of failure to have.
@char-loop
        LDA2 $ZP.ci
        LIT2 $0000
        GTH2
        JNZ @char-go
        ; The countdown is zero, so the pointer has walked the whole way.
        LDA2 $ZP.gx
        LDA2 $ZP.gy
        LDA2 $ZP.gp
        LDZ $ZP.gc
        JSR2 @glyph
        STA2 $ZP.gp                   ; the next glyph, thrown away
        ; And on one cell, which is what makes the strip monospaced.
        LDA2 $ZP.gx
        LIT2 @CELL
        ADD2
        STA2 $ZP.gx
        JMP2r2
@char-go
        LDA2 $ZP.ci
        LIT2 $0001
        SUB2
        STA2 $ZP.ci
        LDA2 $ZP.gp
        LIT2 $0008                    ; eight bytes a glyph, one byte a row
        ADD2
        STA2 $ZP.gp
        JMP @char-loop