; clock.tal - the time, large.
;
;   ./duxasm -X -o roms/clock.rom asm/clock.tal
;   ./dux -c 400000 -f 2 -p /tmp/clock.ppm roms/clock.rom
;   ./duxsdl roms/clock.rom
;
; Six digits and two colons, every frame. The glyphs are the bitmap font in
; asm/lib/fontlib.tal - eight wide, eight down, one byte a row, bit 7 the
; leftmost pixel - and they reach the screen through @plot, one pixel at a time.
;
; Drawn with @plot, not the sprite port
; ------------------------------------
; A sprite byte is four pixels at TWO BITS each, and those two bits are a colour
; index rather than a pixel. So a sprite cannot carry a one-bit-per-pixel glyph at
; all: the row has to be rebuilt before it can be stamped, and a rebuilt row is a
; second description of the same shape that can disagree with the first. @plot
; takes the font bytes as they are. It costs more device writes - five a pixel
; against four a row - and it cannot be a pixel wrong.
;
; The digit shapes
; ----------------
; The digits are bitmap glyphs, not seven-segment figures. A seven-segment figure
; cannot be a right-shaped digit: the 1 has no foot, the 4 is open-topped, the 7
; is bare, and no choice of masks changes that - the shape is not in the data, it
; is in the seven pieces.
;
; Why the digits refresh
; ---------------------
; @clear wipes the whole screen at the top of every frame, so a digit is never
; drawn on top of the one before it. That is the whole of it, and it is worth
; being explicit, because the version this replaces cleared only the boxes the old
; digits had been in: an 8 going to a 1 left the bottom bar behind and the time
; read as a 1 sitting on a stripe. Nothing about that is visible in a pixel count.
;
; Redrawing everything each frame is wasteful and much simpler. There is no
; remembered previous value that can be stale, so the six digits cannot disagree
; with each other or with the time they were read from.

INCLUDE "common.tal"
INCLUDE "lib/fontlib.tal"

@CLK.hour   = $c6
@CLK.minute = $c7
@CLK.second = $c8

; --------------------------------------------------------------- zero page
;
; $28 to $33. common.tal owns $10 to $26 and $7e and $7f; fontlib owns $a0 up.
; Shorts sit on even addresses, because a short keeps its high byte at the lower
; one.
@ZP.v    = $28                    ; the value being split
@ZP.tens = $29
@ZP.un   = $2a
@ZP.x    = $2c                    ; where the next digit goes, a short
@ZP.y    = $2e                    ; the row every digit shares, a short

; ------------------------------------------------------------------ layout
;
; Reading HH:MM:SS with the same space everywhere:
;
;     0  0  :  0  0  :  0  0
;     |  |  |  |  |  |  |  |  |    <- eight clear pixels, every time
;
; Eight clear pixels between every two shapes, whatever they are: between the two
; digits of a number, and between a digit and a colon. One gap, one size, so the
; strip is a single rhythm and the eye can run along it without a surprise.
;
; Eight-wide glyphs make a pitch of sixteen, so @INNER is one pitch: a digit is
; followed by exactly one gap however far away the next shape is. A pair is two
; pitches and leaves the cursor on the colon that follows it; @colon draws where
; the cursor already is and then steps on by its own two pixels plus one gap.
;
; $ZP.x walks the strip and each routine leaves it where the next one starts, so
; the order in @draw is the order on screen and there is no column constant that
; can disagree with another. Only @COL.1 is written down; the other seven positions
; follow from the three distances beside it.
@ROW.Y     = $005a                ; 90, the top of the glyphs
@INNER     = $0010                ; 16: one glyph plus eight clear pixels
@COLON.ADV = $000a                ; 10: the colon's two pixels plus eight clear
@COL.1     = $006a                ; 106, the hour's tens. From there the digits
                                  ; land at 106, 122, 148, 164, 190, 206 and the
                                  ; colons at 138 and 180, so the strip runs 106
                                  ; to 213 - 108 pixels, centred on the 160 of a
                                  ; 320-wide screen.

; ------------------------------------------------------------------- draw
;
; Called once at reset and again every frame by common.tal's vector.
@draw
        ; The screen first, every frame. This is the refresh.
        JSR2 @clear

        LIT2 @ROW.Y
        STA2 $ZP.y
        LIT2 @COL.1
        STA2 $ZP.x

        ; The strip, read left to right. @pair leaves $ZP.x on the next digit and
        ; @colon draws in the gap behind it, so the order here IS the order on
        ; screen and no coordinate is written down twice.
        DEI $CLK.hour
        STA $ZP.v
        JSR2 @pair         ; two digits, then sixteen on
        JSR2 @colon        ; two dots, centred in the gap just left

        DEI $CLK.minute
        STA $ZP.v
        JSR2 @pair         ; two digits, then sixteen on
        JSR2 @colon        ; two dots, centred in the gap just left

        DEI $CLK.second
        STA $ZP.v
        JSR2 @pair         ; the last two digits; the strip ends here

        JMP2r2

; Two digits out of the one byte in $ZP.v: the tens at $ZP.x and the units one
; pitch along. Leaves $ZP.x one pitch past the units, which is where the next
; piece of the strip belongs - a colon after a pair, nothing after the last one.
@pair
        JSR2 @split

        LDA2 $ZP.x
        LDA2 $ZP.y
        LDZ $ZP.tens
        LIT $01
        JSR2 @num

        LDA2 $ZP.x
        LIT2 @INNER
        ADD2
        STA2 $ZP.x
        LDA2 $ZP.x
        LDA2 $ZP.y
        LDZ $ZP.un
        LIT $01
        JSR2 @num

        LDA2 $ZP.x
        LIT2 @INNER
        ADD2
        STA2 $ZP.x
        JMP2r2

; @num walks off the front of @font rather than indexing into it, because
; computing a table's address has been wrong at least once on this machine and a
; walk cannot be. @split has to make the value less than ten first.
@split
        LDZ $ZP.v
        STA $ZP.un                ; the units are the value less the tens, so
        LDZ $ZP.v                 ; the value is wanted again after the division
        LIT $0a
        DIV
        STA $ZP.tens
        LDZ $ZP.un
        LDZ $ZP.tens
        LIT $0a
        MUL
        SUB
        STA $ZP.un
        JMP2r2

; The two dots of a colon, each a two by two block, on the first and fifth rows of
; the digits: two rows of dot, two rows of gap, two rows of dot, so the dots sit
; either side of the middle rather than on it. Rows 0 and 4 rather than 1 and 5,
; because @draw puts $ZP.y on the top row and a colon is a mark between numbers,
; not something indented into them.
;
; The colon is centred in the gap BEHIND $ZP.x, which @pair has already moved on
; to the next digit: eight pixels of gap with a two-pixel colon in it, so the
; colon goes five back. It hands $ZP.x back exactly as it found it - the gap is
; already accounted for by the pair that drew the digits on either side of it, and
; a colon that left the cursor moved would slide the rest of the strip along.
@colon
        ; The cursor is already on this colon's slot - @pair left it there - so
        ; there is nothing to move before drawing.

        LIT2 @ROW.Y
        STA2 $ZP.y
        JSR2 @dot
        LDA2 $ZP.y
        LIT2 $0004
        ADD2
        STA2 $ZP.y
        JSR2 @dot
        ; Put the row back, or every digit after a colon is four rows low.
        ; LIT2 and not LDA2: LDA2 reads memory AT the address, and @ROW.Y is
        ; $005a, which is a device port. It comes back as zero and every digit
        ; after the colon lands on the top row of the screen.
        LIT2 @ROW.Y
        STA2 $ZP.y

        ; And on to the next number: past the colon's own two pixels and one gap.
        LDA2 $ZP.x
        LIT2 @COLON.ADV
        ADD2
        STA2 $ZP.x
        JMP2r2

; A two by two block of colour 1 at $ZP.x, $ZP.y.
;
; Four @plot calls, which is what "drawn with @plot" means: there is no mask and
; no packing, just four pixels at four places. $ZP.dx and $ZP.dy hold the four
; coordinates because @plot wants x, y and colour, and a value already on the
; stack cannot be added to without taking it off and pushing a second copy.
@ZP.dx = $30
@ZP.dy = $32

@dot
        LDA2 $ZP.x
        LIT2 $0001
        ADD2
        STA2 $ZP.dx
        LDA2 $ZP.y
        LIT2 $0001
        ADD2
        STA2 $ZP.dy

        LDA2 $ZP.x
        LDA2 $ZP.y
        LIT $01
        JSR2 @plot
        LDA2 $ZP.dx
        LDA2 $ZP.y
        LIT $01
        JSR2 @plot
        LDA2 $ZP.x
        LDA2 $ZP.dy
        LIT $01
        JSR2 @plot
        LDA2 $ZP.dx
        LDA2 $ZP.dy
        LIT $01
        JSR2 @plot
        JMP2r2
