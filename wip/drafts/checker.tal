; checker.tal - a checkerboard.
;
;   ./duxasm -o roms/checker.rom asm/checker.tal
;   ./duxsdl roms/checker.rom
;
; Ten by ten blocks of eight pixels, alternating. The whole of a checkerboard is
; one AND on (i + j), which is why it is worth drawing at this size: at eight
; pixels a block the board is eighty pixels square and the diagonal reads
; clearly.
;
; Every position here is a short built by widening a byte and adding, never a
; byte stored over half of a short. That is not fussiness: a byte store into a
; short leaves the other half holding whatever was there, which is in bounds,
; assembles clean, and reads back multiplied by 256.

INCLUDE "common.tal"

@draw
        JSR2 @clear
        STA $ZP.j $00
@crow
        STA $ZP.i $00
@ccol
        ; The colour of this cell, and where its top left corner is.
        ;
        ; One more than the parity, not the parity itself: colour zero is the
        ; background, so a board drawn straight from the parity is half erased
        ; and looks like a bug in the loop rather than in the palette.
        ; Colour one or two, by whether the two counters agree. Comparing beats
        ; masking the parity: AND is a byte operation and the counters are
        ; bytes, but an AND on a short leaves its high half behind, and here the
        ; short form would leave two bytes where @plot wants one.
        LDZ $ZP.i
        LDZ $ZP.j
        EQU
        STA $ZP.t
        LDZ $ZP.t
        LIT $01
        ADD
        STA $ZP.t

        LDZ $ZP.i
        JSR2 @widen
        LIT2 $0010
        MUL2
        STA2 $ZP.ex
        LDZ $ZP.j
        JSR2 @widen
        LIT2 $0010
        MUL2
        STA2 $ZP.ey

        STA $ZP.k $00
@bx
        STA $ZP.m $00
@by
        LDZ $ZP.k
        JSR2 @widen
        LDA2 $ZP.ex
        ADD2
        STA2 $ZP.rx
        LDZ $ZP.m
        JSR2 @widen
        LDA2 $ZP.ey
        ADD2
        STA2 $ZP.ry
        LDZ2 $ZP.rx
        LDZ2 $ZP.ry
        LDZ $ZP.t
        JSR2 @plot
        LDZ $ZP.m
        LIT $01
        ADD
        STA $ZP.m
        LDZ $ZP.m
        LIT $07
        GTH
        JNZ @by-end
        JMP @by
@by-end
        LDZ $ZP.k
        LIT $01
        ADD
        STA $ZP.k
        LDZ $ZP.k
        LIT $07
        GTH
        JNZ @bx-end
        JMP @bx
@bx-end
        LDZ $ZP.i
        LIT $01
        ADD
        STA $ZP.i
        LDZ $ZP.i
        LIT $09
        GTH
        JNZ @ccol-end
        JMP @ccol
@ccol-end
        LDZ $ZP.j
        LIT $01
        ADD
        STA $ZP.j
        LDZ $ZP.j
        LIT $09
        GTH
        JNZ @crow-end
        JMP @crow
@crow-end
        JMP2r2