INCLUDE "common.tal"

@draw
        JSR2 @clear
        LIT2 $0000
        STA2 $ZP.sj
@row
        LIT2 $0000
        STA2 $ZP.si
@col
        ; A wide V: the row may not be deeper than the nearer of the two middle
        ; columns. Summed by column that is 1+2+...+160 twice over, 25760.
        LDA2 $ZP.sj
        LDA2 $ZP.si
        LTH2
        JNZ @col-end
        LIT2 $013f
        LDA2 $ZP.si
        SUB2
        LDA2 $ZP.sj
        LTH2
        JNZ @col-end
        LIT $01
        JSR2 @plotat
@col-end
        LDA2 $ZP.si
        LIT2 $0001
        ADD2
        STA2 $ZP.si
        LDA2 $ZP.si
        LIT2 $0140
        GTH2
        JNZ @col-end2
        JMP @col
@col-end2
        LDA2 $ZP.sj
        LIT2 $0001
        ADD2
        STA2 $ZP.sj
        LDA2 $ZP.sj
        LIT2 $00c8
        GTH2
        JNZ @row-end
        JMP @row
@row-end
        JMP2r2
