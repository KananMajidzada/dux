; Probe: which way round is a comparison's operands?
;
; The written-down rule is that `GTH(a,b)` pushes `b > a` and `LTH(a,b)`
; pushes `b < a`, so the *second* value pushed is on the left. Both @abs and
; @sgn in gears.tal depend on which is true - a sign test written backwards
; still assembles, still balances, and turns every positive delta negative.
;
; So: five comparisons of the same two values, one per row. Each plots its flag
; at x = 40 when true and leaves x = 40 black when false, so the lit pixel
; column reads off the answers directly.
;
;   y = 40   GTH  $05 $03     (5 > 3)
;   y = 42   GTH  $03 $05     (3 > 5)
;   y = 44   GTH  $05 $05     (5 == 5, must be false)
;   y = 46   LTH  $05 $03
;   y = 48   EQU  $05 $03

INCLUDE "../asm/common.tal"

@ZP.y      = $60
@ZP.base   = $0028

@draw
        JSR2 @clear

        LIT2 @ZP.base
        STA2 $ZP.y

        LIT $05
        LIT $03
        GTH
        JSR2 @t1

        LIT $03
        LIT $05
        GTH
        JSR2 @t1

        LIT $05
        LIT $05
        GTH
        JSR2 @t1

        LIT $05
        LIT $03
        LTH
        JSR2 @t1

        LIT $05
        LIT $03
        EQU
        JSR2 @t1

        JMP2r2

; Stack: the flag. Plot it at x = $28 on this row, then step the row down by
; two. Nothing else is left behind, so all five rows share one x column.
@t1
        DUP
        MUL                             ; the flag squared: 1 when true, 0 when not
        JSR2 @widen
        LIT2 $0028
        ADD2
        LDA2 $ZP.y
        LIT $01
        JSR2 @plot
        LDA2 $ZP.y
        LIT2 $0002
        SUB2
        STA2 $ZP.y
        JMP2r2