; zigzag.tal - a zigzag that bounces off x = $a0
;
;   ./duxasm -o roms/zigzag.rom asm/zigzag.tal
;   ./duxsdl roms/zigzag.rom
;
; One pixel per row, stepping right and left away from x = $a0. The tests
; had the same inverted-branch bug xmark had, so it drew a single pixel.
INCLUDE "common.tal"

@draw
        JSR2 @clear
        LIT2 $0000
        STA2 $ZP.sj
@row
        LIT2 $0000
        STA2 $ZP.si
@col
        ; A zigzag: the pixel is on it when the column is the row's distance from
        ; the middle, either side of it. 159 rows carry two pixels and the two
        ; end rows carry one each, so 320.
        LIT2 $00a0
        LDA2 $ZP.sj
        SUB2
        LDA2 $ZP.si
        NEQ2
        JNZ @try-right
        JMP @zig-draw
@try-right
        LIT2 $00a0
        LDA2 $ZP.sj
        ADD2
        LDA2 $ZP.si
        NEQ2
        JNZ @col-end
@zig-draw
        LIT $01
        JSR2 @plotat
@col-end
        LDA2 $ZP.si
        LIT2 $0001
        ADD2
        STA2 $ZP.si
        LDA2 $ZP.si
        LIT2 $0140
        GTH2
        JNZ @col-end2
        JMP @col
@col-end2
        LDA2 $ZP.sj
        LIT2 $0001
        ADD2
        STA2 $ZP.sj
        LDA2 $ZP.sj
        LIT2 $00c8
        GTH2
        JNZ @row-end
        JMP @row
@row-end
        JMP2r2
