; stripes3.tal - horizontal bands seventeen on, fifteen off, every thirty-two
; rows: one row longer than stripes2's, which is the whole difference.

;   ./duxasm -o roms/stripes3.rom asm/stripes3.tal
;   ./duxsdl roms/stripes3.rom
;
INCLUDE "common.tal"

@draw
        JSR2 @clear
        LIT2 $0000
        STA2 $ZP.sj
@row
        LIT2 $0000
        STA2 $ZP.si
@col
        ; Stripes on a thirty-two period with half of each lit, which is the
        ; first period here that does not divide the two hundred rows evenly:
        ; six whole groups and a half, so 104 lit rows of 320 - 33280.

        LDA2 $ZP.sj
        LIT2 $001f
        AND2
        LIT2 $0010
        GTH2
        JNZ @col-end
        LIT $01
        JSR2 @plotat
@col-end
@col-end
        LDA2 $ZP.si
        LIT2 $0001
        ADD2
        STA2 $ZP.si
        LDA2 $ZP.si
        LIT2 $0140
        GTH2
        JNZ @col-end2
        JMP @col
@col-end2
        LDA2 $ZP.sj
        LIT2 $0001
        ADD2
        STA2 $ZP.sj
        LDA2 $ZP.sj
        LIT2 $00c8
        GTH2
        JNZ @row-end
        JMP @row
@row-end
        JMP2r2
