; hstripe.tal - horizontal stripes, five rows on of every eight
;
;   ./duxasm -o roms/hstripe.rom asm/hstripe.tal
;   ./duxsdl roms/hstripe.rom
;
; The simplest figure here that needs a mask rather than a division, and worth
; keeping for the contrast with stripes3: eight rows on, eight off, out of
; sixteen. Its paint covers more of the screen than its ground, so the verifier
; needs --bg to tell which is which.
INCLUDE "common.tal"

@draw
        JSR2 @clear
        LIT2 $0000
        STA2 $ZP.sj
@row
        LIT2 $0000
        STA2 $ZP.si
@col
        ; Eight rows lit in every sixteen, down the screen.

        LDA2 $ZP.sj
        LIT2 $0007
        AND2
        LIT2 $0004
        GTH2
        JNZ @col-end
        LIT $01
        JSR2 @plotat
@col-end
@col-end
        LDA2 $ZP.si
        LIT2 $0001
        ADD2
        STA2 $ZP.si
        LDA2 $ZP.si
        LIT2 $0140
        GTH2
        JNZ @col-end2
        JMP @col
@col-end2
        LDA2 $ZP.sj
        LIT2 $0001
        ADD2
        STA2 $ZP.sj
        LDA2 $ZP.sj
        LIT2 $00c8
        GTH2
        JNZ @row-end
        JMP @row
@row-end
        JMP2r2
