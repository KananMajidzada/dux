; blocks3.tal - eight-pixel columns, sixteen-pixel rows
;
;   ./duxasm -o roms/blocks3.rom asm/blocks3.tal
;   ./duxsdl roms/blocks3.rom
;
; Columns are eight of every sixteen and rows are five of every thirty-two, so
; the cell is eight wide and thirty-two tall: a brick rather than a square. The
; file existed as a duplicate of blocks.tal before this, which is worth noting
; because the distinctness check catches duplicates and this is how it earns
; its place.
INCLUDE "common.tal"

@draw
        JSR2 @clear
        LIT2 $0000
        STA2 $ZP.sj
@row
        LIT2 $0000
        STA2 $ZP.si
@col
        ; Blocks of eight on the sixteen lattice, in both axes.

        LDA2 $ZP.si
        LIT2 $000f
        AND2
        LIT2 $0007
        GTH2
        JNZ @col-end
        LDA2 $ZP.sj
        LIT2 $001f
        AND2
        LIT2 $0004
        GTH2
        JNZ @col-end
        LIT $01
        JSR2 @plotat
@col-end
@col-end
        LDA2 $ZP.si
        LIT2 $0001
        ADD2
        STA2 $ZP.si
        LDA2 $ZP.si
        LIT2 $0140
        GTH2
        JNZ @col-end2
        JMP @col
@col-end2
        LDA2 $ZP.sj
        LIT2 $0001
        ADD2
        STA2 $ZP.sj
        LDA2 $ZP.sj
        LIT2 $00c8
        GTH2
        JNZ @row-end
        JMP @row
@row-end
        JMP2r2
