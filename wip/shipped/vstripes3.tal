; vstripes3.tal - the transpose of stripes3: vertical bands seventeen on,
; fifteen off, every thirty-two columns.

;   ./duxasm -o roms/vstripes3.rom asm/vstripes3.tal
;   ./duxsdl roms/vstripes3.rom
;
INCLUDE "common.tal"

@draw
        JSR2 @clear
        LIT2 $0000
        STA2 $ZP.sj
@row
        LIT2 $0000
        STA2 $ZP.si
@col
        ; The same rule turned on its side, so the bars run down rather than
        ; across: 104 lit columns of two hundred. 20800 pixels.

        LDA2 $ZP.si
        LIT2 $001f
        AND2
        LIT2 $0010
        GTH2
        JNZ @col-end
        LIT $01
        JSR2 @plotat
@col-end
@col-end
        LDA2 $ZP.si
        LIT2 $0001
        ADD2
        STA2 $ZP.si
        LDA2 $ZP.si
        LIT2 $0140
        GTH2
        JNZ @col-end2
        JMP @col
@col-end2
        LDA2 $ZP.sj
        LIT2 $0001
        ADD2
        STA2 $ZP.sj
        LDA2 $ZP.sj
        LIT2 $00c8
        GTH2
        JNZ @row-end
        JMP @row
@row-end
        JMP2r2
