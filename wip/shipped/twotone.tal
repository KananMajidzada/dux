INCLUDE "common.tal"

@draw
        JSR2 @clear
        LIT2 $0000
        STA2 $ZP.sj
@row
        LIT2 $0000
        STA2 $ZP.si
@col
        ; The same inset box, split down the middle: one colour left of 160 and
        ; the other right of it. 288 * 168 = 48384 lit, 24192 a side.
        LDA2 $ZP.si
        LIT2 $0010
        LTH2
        JNZ @col-end
        LDA2 $ZP.si
        LIT2 $012f
        GTH2
        JNZ @col-end
        LDA2 $ZP.sj
        LIT2 $0010
        LTH2
        JNZ @col-end
        LDA2 $ZP.sj
        LIT2 $00b7
        GTH2
        JNZ @col-end
        LDA2 $ZP.si
        LIT2 $009f
        GTH2
        JNZ @right
        LIT $01
        JSR2 @plotat
        JMP @col-end
@right
        LIT $02
        JSR2 @plotat
@col-end
        LDA2 $ZP.si
        LIT2 $0001
        ADD2
        STA2 $ZP.si
        LDA2 $ZP.si
        LIT2 $0140
        GTH2
        JNZ @col-end2
        JMP @col
@col-end2
        LDA2 $ZP.sj
        LIT2 $0001
        ADD2
        STA2 $ZP.sj
        LDA2 $ZP.sj
        LIT2 $00c8
        GTH2
        JNZ @row-end
        JMP @row
@row-end
        JMP2r2
