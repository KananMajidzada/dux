; stripes2.tal - horizontal bands sixteen on, sixteen off, every thirty-two
; rows, so the phase repeats and no division is needed.

;   ./duxasm -o roms/stripes2.rom asm/stripes2.tal
;   ./duxsdl roms/stripes2.rom
;
INCLUDE "common.tal"

@draw
        JSR2 @clear
        LIT2 $0000
        STA2 $ZP.sj
@row
        LIT2 $0000
        STA2 $ZP.si
@col
        ; Stripes twelve deep with six of them lit, so the period does not divide
        ; the height evenly and the last rows are left short - which is the point
        ; of not choosing a power of two for everything.

        LDA2 $ZP.sj
        LIT2 $000b
        AND2
        LIT2 $0005
        GTH2
        JNZ @col-end
        LIT $01
        JSR2 @plotat
@col-end
@col-end
        LDA2 $ZP.si
        LIT2 $0001
        ADD2
        STA2 $ZP.si
        LDA2 $ZP.si
        LIT2 $0140
        GTH2
        JNZ @col-end2
        JMP @col
@col-end2
        LDA2 $ZP.sj
        LIT2 $0001
        ADD2
        STA2 $ZP.sj
        LDA2 $ZP.sj
        LIT2 $00c8
        GTH2
        JNZ @row-end
        JMP @row
@row-end
        JMP2r2
