INCLUDE "common.tal"

@draw
        JSR2 @clear
        LIT2 $0000
        STA2 $ZP.sj
@row
        LIT2 $0000
        STA2 $ZP.si
@col
        ; Single pixels on an eight lattice - every one of the 40 columns and 25
        ; rows that divide into it.

        LDA2 $ZP.si
        LIT2 $0007
        AND2
        JSR2 @toflag
        JNZ @col-end
        LDA2 $ZP.sj
        LIT2 $0007
        AND2
        JSR2 @toflag
        JNZ @col-end
        LIT $01
        JSR2 @plotat
@col-end
@col-end
        LDA2 $ZP.si
        LIT2 $0001
        ADD2
        STA2 $ZP.si
        LDA2 $ZP.si
        LIT2 $0140
        GTH2
        JNZ @col-end2
        JMP @col
@col-end2
        LDA2 $ZP.sj
        LIT2 $0001
        ADD2
        STA2 $ZP.sj
        LDA2 $ZP.sj
        LIT2 $00c8
        GTH2
        JNZ @row-end
        JMP @row
@row-end
        JMP2r2
