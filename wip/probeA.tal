; probeA - do the checker's four nested loops alone, then report the counters.
; Nothing is plotted, so any wrong answer here is the loop's own.
INCLUDE "common.tal"

@draw
        STA $ZP.j $00
@crow
        STA $ZP.i $00
@ccol
        STA $ZP.k $00
@bx
        STA $ZP.m $00
@by
        LDZ $ZP.m
        LIT $01
        ADD
        STA $ZP.m
        LDZ $ZP.m
        LIT $07
        GTH
        JNZ @by-end
        JMP @by
@by-end
        LDZ $ZP.k
        LIT $01
        ADD
        STA $ZP.k
        LDZ $ZP.k
        LIT $07
        GTH
        JNZ @bx-end
        JMP @bx
@bx-end
        LDZ $ZP.i
        LIT $01
        ADD
        STA $ZP.i
        LDZ $ZP.i
        LIT $09
        GTH
        JNZ @ccol-end
        JMP @ccol
@ccol-end
        LDZ $ZP.j
        LIT $01
        ADD
        STA $ZP.j
        LDZ $ZP.j
        LIT $09
        GTH
        JNZ @crow-end
        JMP @crow
@crow-end
        LDZ $ZP.i
        JSR2 @widen
        JSR2 @show
        LDZ $ZP.j
        JSR2 @widen
        JSR2 @show
        LDZ $ZP.k
        JSR2 @widen
        JSR2 @show
        LDZ $ZP.m
        JSR2 @widen
        JSR2 @show
        JMP2r2
